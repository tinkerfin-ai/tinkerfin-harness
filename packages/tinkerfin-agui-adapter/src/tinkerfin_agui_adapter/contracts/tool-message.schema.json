{
  "$defs": {
    "Attachment": {
      "additionalProperties": false,
      "description": "Describe a durable file without embedding bytes or storage credentials.\n\nIDs are opaque within the host's authorization boundary. A host must authorize\nevery resolution; the descriptor itself never grants access to its contents.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "size_bytes": {
          "description": "Original file size in bytes",
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "mime_type",
        "size_bytes"
      ],
      "title": "Attachment",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Preserve a tool result's durable files in an authoritative message snapshot.",
  "properties": {
    "attachments": {
      "items": {
        "$ref": "#/$defs/Attachment"
      },
      "title": "Attachments",
      "type": "array"
    },
    "content": {
      "title": "Content",
      "type": "string"
    },
    "encryptedValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Encryptedvalue"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "role": {
      "const": "tool",
      "default": "tool",
      "title": "Role",
      "type": "string"
    },
    "toolCallId": {
      "title": "Toolcallid",
      "type": "string"
    }
  },
  "required": [
    "id",
    "content",
    "toolCallId"
  ],
  "title": "AttachmentToolMessage",
  "type": "object"
}
