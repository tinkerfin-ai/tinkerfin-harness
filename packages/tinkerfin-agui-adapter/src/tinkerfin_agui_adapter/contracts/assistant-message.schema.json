{
  "$defs": {
    "Attachment": {
      "additionalProperties": false,
      "description": "Describe a durable file without embedding bytes or storage credentials.\n\nIDs are opaque within the host's authorization boundary. A host must authorize\nevery resolution; the descriptor itself never grants access to its contents.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "size_bytes": {
          "description": "Original file size in bytes",
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "mime_type",
        "size_bytes"
      ],
      "title": "Attachment",
      "type": "object"
    },
    "FunctionCall": {
      "additionalProperties": true,
      "description": "Name and arguments of a function call.",
      "properties": {
        "arguments": {
          "title": "Arguments",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "FunctionCall",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": true,
      "description": "A tool call, modelled after OpenAI tool calls.",
      "properties": {
        "encryptedValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encryptedvalue"
        },
        "function": {
          "$ref": "#/$defs/FunctionCall"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "function"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Preserve an assistant's durable files in an authoritative message snapshot.",
  "properties": {
    "attachments": {
      "items": {
        "$ref": "#/$defs/Attachment"
      },
      "title": "Attachments",
      "type": "array"
    },
    "content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content"
    },
    "encryptedValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Encryptedvalue"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "role": {
      "const": "assistant",
      "default": "assistant",
      "title": "Role",
      "type": "string"
    },
    "toolCalls": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Toolcalls"
    }
  },
  "required": [
    "id"
  ],
  "title": "AttachmentAssistantMessage",
  "type": "object"
}
