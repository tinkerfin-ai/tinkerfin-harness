    "ActivityMessage": {
      "additionalProperties": true,
      "description": "An activity progress message emitted between chat messages.",
      "properties": {
        "activityType": {
          "title": "Activitytype",
          "type": "string"
        },
        "content": {
          "additionalProperties": true,
          "title": "Content",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "const": "activity",
          "default": "activity",
