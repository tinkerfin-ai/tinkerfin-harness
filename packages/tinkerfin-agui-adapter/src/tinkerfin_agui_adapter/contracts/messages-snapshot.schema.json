  "additionalProperties": true,
  "description": "Validate and serialize attachment-bearing assistant and tool messages.\n\nAG-UI 0.1.19 annotates snapshots with its base message union. Pydantic otherwise\nomits declared subclass fields at that boundary. Runtime serialization and the\ninput schema therefore both include the public attachment message types.",
  "properties": {
    "messages": {
      "items": {
        "discriminator": {
          "mapping": {
            "activity": "#/$defs/ActivityMessage",
            "assistant": "#/$defs/AttachmentAssistantMessage",
            "developer": "#/$defs/DeveloperMessage",
            "reasoning": "#/$defs/ReasoningMessage",
            "system": "#/$defs/SystemMessage",
            "tool": "#/$defs/AttachmentToolMessage",
            "user": "#/$defs/UserMessage"
          },
          "propertyName": "role"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DeveloperMessage"
          },
          {
            "$ref": "#/$defs/SystemMessage"
          },
          {
            "$ref": "#/$defs/AttachmentAssistantMessage"
          },
          {
            "$ref": "#/$defs/UserMessage"
          },
          {
            "$ref": "#/$defs/AttachmentToolMessage"
          },
          {
            "$ref": "#/$defs/ActivityMessage"
          },
          {
            "$ref": "#/$defs/ReasoningMessage"
          }
        ]
      },
      "title": "Messages",
      "type": "array"
    },
    "rawEvent": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rawevent"
    },
    "timestamp": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timestamp"
    },
    "type": {
      "const": "MESSAGES_SNAPSHOT",
      "default": "MESSAGES_SNAPSHOT",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "messages"
  ],
  "title": "AttachmentMessagesSnapshotEvent",
  "type": "object"
}
