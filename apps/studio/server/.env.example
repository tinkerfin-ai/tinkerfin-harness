# MySQL 8.0，必须使用原生异步 asyncmy 驱动
DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/tinkerfin?charset=utf8mb4
DATABASE_ECHO=false

REDIS_RUNTIME_HOST=127.0.0.1
REDIS_RUNTIME_PORT=6379
REDIS_RUNTIME_PASSWORD=
REDIS_RUNTIME_PASSWORD_FILE=
REDIS_RUNTIME_DB=0
REDIS_RUNTIME_CHECKPOINT_DB=0

# OpenSandbox
OPEN_SANDBOX_DOMAIN=127.0.0.1:8091
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_WARM_POOL_SIZE=0
OPEN_SANDBOX_WORKSPACE_ROOT=/workspace
OPEN_SANDBOX_STATE_NAMESPACE=tinkerfin-studio

# 业务 Tool
TAVILY_API_KEY=

# 应用 S3 存储，桶名必填；本机连接 deploy 启动的 MinIO
S3_STORAGE_BUCKET=
S3_STORAGE_ENDPOINT=http://127.0.0.1:9000
S3_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_STORAGE_ACCESS_KEY_FILE=deploy/secrets/s3_storage_access_key
S3_STORAGE_SECRET_KEY_FILE=deploy/secrets/s3_storage_secret_key

# 管理员允许的 HTTP、本机或内网模型服务，JSON 数组中只填写协议、主机和端口
# 例如 MODEL_ALLOWED_ORIGINS=["http://127.0.0.1:11434","http://localhost:11434"]
MODEL_ALLOWED_ORIGINS=[]

# 默认输出到控制台；文件日志按需开启，路径相对此配置文件
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/studio.log
# 50 MiB 滚动阈值，另保留 3 个备份文件
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=3
