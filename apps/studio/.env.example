# init-env.sh 首次生成随机凭据；已有配置不会重置密码

# 部署：bundled 启动全部依赖；服务名以逗号分隔；留空使用外部依赖
COMPOSE_PROFILES=bundled

# MySQL：业务库与组件库使用独立账号
MYSQL_PUBLISHED_PORT=13306
MYSQL_ROOT_PASSWORD=
MYSQL_BUSINESS_PASSWORD=
MYSQL_COMPONENTS_PASSWORD=

# Redis
REDIS_RUNTIME_PUBLISHED_PORT=6379
REDIS_RUNTIME_PASSWORD=

# MinIO：远程访问时填写浏览器可达的地址，并开放对应端口
S3_STORAGE_PUBLISHED_PORT=9000
S3_STORAGE_BUCKET=tinkerfin
S3_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_STORAGE_ACCESS_KEY=
S3_STORAGE_SECRET_KEY=

# OpenSandbox
OPEN_SANDBOX_PUBLISHED_PORT=8091
OPEN_SANDBOX_API_KEY=

# 模型与搜索：模型连接在 Studio 页面配置，HTTP 或内网模型地址需加入允许列表
MODEL_ALLOWED_ORIGINS=[]
TAVILY_API_KEY=

# 技能库默认提供 ClawHub、Anthropic、Vercel；仅覆盖默认来源时设置 SKILL_SOURCES JSON 列表
# GitHub 来源读取公开仓库的 skills/ 目录，可通过 token 字段配置 GitHub API 凭据

# 日志：容器内启用文件日志时，需设置绝对路径并自行挂载可写目录
LOG_FILE_ENABLED=false
LOG_FILE_PATH=server/logs/studio.log
