+// Chromium 155 DevToolsPipeHandler uses NUL-delimited UTF-8. The host bounds
+// each payload to 100 MiB; the terminating NUL is not part of this host limit.
+#[cfg(feature = "managed-process")]
+const PIPE_FRAME_LIMIT: usize = 100 * 1024 * 1024;
+
+#[cfg(feature = "managed-process")]
+async fn read_pipe_frame<R: tokio::io::AsyncBufRead + Unpin>(
+    reader: &mut R,
+    limit: usize,
+) -> Result<Option<String>, String> {
+    use tokio::io::AsyncBufReadExt;
+    let mut frame = Vec::new();
+    loop {
+        let chunk = reader.fill_buf().await.map_err(|e| e.to_string())?;
+        if chunk.is_empty() {
+            return if frame.is_empty() {
+                Ok(None)
+            } else {
+                Err("CDP pipe closed during a message".to_string())
+            };
+        }
+        let delimiter = chunk.iter().position(|byte| *byte == 0);
+        let length = delimiter.unwrap_or(chunk.len());
+        if length > limit.saturating_sub(frame.len()) {
+            return Err("CDP pipe message exceeds its capacity".to_string());
+        }
+        frame.extend_from_slice(&chunk[..length]);
+        reader.consume(length + usize::from(delimiter.is_some()));
+        if delimiter.is_some() {
+            return String::from_utf8(frame)
+                .map(Some)
+                .map_err(|e| e.to_string());
+        }
+    }
+}
