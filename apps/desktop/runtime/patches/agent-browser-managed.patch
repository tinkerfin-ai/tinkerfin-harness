+#[cfg(feature = "managed-process")]
+static MANAGED_SCOPE: std::sync::OnceLock<ManagedBrowserScope> = std::sync::OnceLock::new();
+
+/// A daemon owns one browser identity and one network grant for its whole lifetime.
+/// Capture before Tokio starts; command-line clients cannot change these bindings.
+#[cfg(feature = "managed-process")]
+struct ManagedBrowserScope {
+    token: String,
+    launch: serde_json::Map<String, serde_json::Value>,
+    proxy: Option<serde_json::Value>,
+}
+
+#[cfg(feature = "managed-process")]
+impl ManagedBrowserScope {
+    fn capture() -> Result<Self, String> {
+        validate_managed_environment()?;
+        let flags = parse_flags(&[]);
+        if flags.cdp.is_some()
+            || flags.auto_connect
+            || env::var_os("AGENT_BROWSER_AUTO_CONNECT").is_some()
+            || flags.provider.is_some()
+            || flags.device.is_some()
+            || flags.engine.as_deref().unwrap_or("chrome") != "chrome"
+            || !flags.plugins.is_empty()
+        {
+            return Err("Managed browsers cannot use external providers or plugins".to_string());
+        }
+        let arguments: Vec<&str> = flags
+            .args
+            .as_deref()
+            .unwrap_or_default()
+            .split([',', '\n'])
+            .map(str::trim)
+            .filter(|arg| !arg.is_empty())
+            .collect();
+        let launch = serde_json::json!({
+            "profile": flags.profile,
+            "executablePath": flags.executable_path,
+            "args": arguments,
+            "engine": "chrome",
+            "extensions": flags.extensions,
+            "headless": !flags.headed,
+            "noXvfb": flags.no_xvfb,
+        })
+        .as_object()
+        .expect("launch bindings are an object")
+        .clone();
+        let proxy = flags.proxy.as_ref().map(|value| {
+            let parsed = crate::parse_proxy(value);
+            let mut proxy = serde_json::json!({"server": parsed.server});
+            for (field, value) in [
+                ("username", parsed.username),
+                ("password", parsed.password),
+                ("bypass", flags.proxy_bypass.clone()),
+            ] {
+                if let Some(value) = value {
+                    proxy[field] = serde_json::Value::String(value);
+                }
+            }
+            proxy
+        });
+        Ok(Self {
+            token: env::var("AGENT_BROWSER_CONNECTION_TOKEN")
+                .map_err(|_| "Missing host-managed browser identity")?,
+            launch,
+            proxy,
+        })
+    }
+
+    fn prepare(&self, mut envelope: serde_json::Value) -> Result<serde_json::Value, String> {
+        use subtle::ConstantTimeEq;
+        let received = envelope
+            .get("connectionToken")
+            .and_then(serde_json::Value::as_str)
+            .unwrap_or_default();
+        if !bool::from(self.token.as_bytes().ct_eq(received.as_bytes())) {
+            return Err("Invalid managed browser identity".to_string());
+        }
+        let mut command = envelope
+            .as_object_mut()
+            .and_then(|object| object.remove("command"))
+            .ok_or("Missing managed browser command")?;
+        let object = command
+            .as_object_mut()
+            .ok_or("Managed browser command must be an object")?;
+        let action = object
+            .get("action")
+            .and_then(serde_json::Value::as_str)
+            .ok_or("Managed browser action must be a string")?;
+        if matches!(
+            action,
+            "stream_enable" | "stream_disable" | "stream_status" | "inspect" | "cdp_url"
+        ) {
+            return Err(
+                "Browser services and debugging endpoints are owned by the host".to_string(),
+            );
+        }
+        // Plugins are consulted on implicit launches too, not only action=launch.
+        if object
+            .get("plugins")
+            .is_some_and(|value| value.as_array().is_none_or(|plugins| !plugins.is_empty()))
+        {
+            return Err("Browser plugins are owned by the host".to_string());
+        }
+        if action != "launch" {
+            return Ok(command);
+        }
+        for field in object.keys() {
+            if self.launch.contains_key(field)
+                || matches!(
+                    field.as_str(),
+                    "id" | "action"
+                        | "plugins"
+                        | "storageState"
+                        | "userAgent"
+                        | "ignoreHTTPSErrors"
+                        | "colorScheme"
+                        | "downloadPath"
+                        | "hideScrollbars"
+                        | "webgpu"
+                        | "allowFileAccess"
+                        | "enable"
+                        | "initScripts"
+                        | "allowedDomains"
+                        | "restoreKey"
+                        | "restoreSave"
+                        | "restoreCheckUrl"
+                        | "restoreCheckText"
+                        | "restoreCheckFn"
+                )
+            {
+                continue;
+            }
+            return Err(format!(
+                "Browser launch field '{}' is not allowed in the host-managed scope",
+                field
+            ));
+        }
+        for (field, expected) in &self.launch {
+            if object
+                .get(field)
+                .is_some_and(|received| received != expected)
+            {
+                return Err(format!(
+                    "Browser launch field '{}' is owned by the host",
+                    field
+                ));
+            }
+            object.insert(field.clone(), expected.clone());
+        }
+        if let Some(proxy) = &self.proxy {
+            object.insert("proxy".to_string(), proxy.clone());
+        }
+        Ok(command)
+    }
+}
