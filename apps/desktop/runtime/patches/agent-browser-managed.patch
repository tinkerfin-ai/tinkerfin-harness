+#[cfg(feature = "managed-process")]
+pub fn freeze_managed_scope() -> Result<(), String> {
+    let scope = ManagedBrowserScope::capture()?;
+    // Official implicit launches read the daemon environment. Canonicalize it
+    // once from the same bindings used to validate explicit launch envelopes.
+    for (field, name) in [
+        ("profile", "AGENT_BROWSER_PROFILE"),
+        ("executablePath", "AGENT_BROWSER_EXECUTABLE_PATH"),
+        ("engine", "AGENT_BROWSER_ENGINE"),
+    ] {
+        env::set_var(
+            name,
+            scope.launch[field]
+                .as_str()
+                .expect("validated launch binding"),
+        );
+    }
+    for (field, name) in [
+        ("args", "AGENT_BROWSER_ARGS"),
+        ("extensions", "AGENT_BROWSER_EXTENSIONS"),
+    ] {
+        let values = scope.launch[field].as_array().expect("launch list binding");
+        env::set_var(
+            name,
+            values
+                .iter()
+                .map(|value| value.as_str().expect("launch string binding"))
+                .collect::<Vec<_>>()
+                .join(","),
+        );
+    }
+    env::set_var(
+        "AGENT_BROWSER_HEADED",
+        if scope.launch["headless"] == false {
+            "1"
+        } else {
+            "0"
+        },
+    );
+    env::set_var(
+        "AGENT_BROWSER_NO_XVFB",
+        if scope.launch["noXvfb"] == true {
+            "1"
+        } else {
+            "0"
+        },
+    );
+    env::set_var("AGENT_BROWSER_PLUGINS", "[]");
+    for (field, name) in [
+        ("server", "AGENT_BROWSER_PROXY"),
+        ("bypass", "AGENT_BROWSER_PROXY_BYPASS"),
+        ("username", "AGENT_BROWSER_PROXY_USERNAME"),
+        ("password", "AGENT_BROWSER_PROXY_PASSWORD"),
+    ] {
+        match scope
+            .proxy
+            .as_ref()
+            .and_then(|proxy| proxy.get(field))
+            .and_then(serde_json::Value::as_str)
+        {
+            Some(value) => env::set_var(name, value),
+            None => env::remove_var(name),
+        }
+    }
+    MANAGED_SCOPE
+        .set(scope)
+        .map_err(|_| "Managed browser scope was already initialized".to_string())
+}
+
+#[cfg(feature = "managed-process")]
+pub fn prepare_managed_command(envelope: serde_json::Value) -> Result<serde_json::Value, String> {
+    MANAGED_SCOPE
+        .get()
+        .ok_or("Missing managed browser scope")?
+        .prepare(envelope)
 }
 
