+#[cfg(feature = "managed-process")]
+pub fn validate_managed_environment() -> Result<(), String> {
+    for name in [
+        "AGENT_BROWSER_SOCKET_DIR",
+        "AGENT_BROWSER_PROFILE",
+        "AGENT_BROWSER_EXECUTABLE_PATH",
+        "AGENT_BROWSER_CONFIG",
+        "AGENT_BROWSER_STATE_DIR",
+    ] {
+        let value = env::var(name).map_err(|_| "Missing host-managed browser scope")?;
+        if !Path::new(&value).is_absolute() {
+            return Err("Host-managed browser paths must be absolute".to_string());
+        }
+    }
+    let session =
+        env::var("AGENT_BROWSER_SESSION").map_err(|_| "Missing host-managed browser session")?;
+    if !crate::validation::is_valid_session_name(&session) {
+        return Err("Invalid host-managed browser session".to_string());
+    }
+    let token = env::var("AGENT_BROWSER_CONNECTION_TOKEN")
+        .map_err(|_| "Missing host-managed browser identity")?;
+    if token.len() != 64 || !token.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        return Err("Invalid host-managed browser identity".to_string());
+    }
+    Ok(())
+}
