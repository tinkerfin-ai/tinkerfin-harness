+        assert_eq!(
+            read_managed_line(&mut reader, &mut line, 4).await.unwrap(),
+            4
+        );
+        assert_eq!(line, "éx\n");
+        assert_eq!(
+            read_managed_line(&mut reader, &mut line, 4).await.unwrap(),
+            3
+        );
+        assert_eq!(line, "{}\n");
+        assert_eq!(
+            read_managed_line(&mut reader, &mut line, 4).await.unwrap(),
+            0
+        );
+        for (input, expected) in [
+            (&b"abcd\n"[..], std::io::ErrorKind::InvalidData),
+            (&b"abcde"[..], std::io::ErrorKind::InvalidData),
+            (&b"{}"[..], std::io::ErrorKind::UnexpectedEof),
