+#[cfg(feature = "managed-process")]
+pub fn validate_managed_flags(
+    args: &[String],
+    flags: &Flags,
+    clean: &[String],
+) -> Result<(), String> {
+    if args
+        .iter()
+        .any(|arg| matches!(arg.as_str(), "--help" | "-h" | "--version" | "-V"))
+        || clean.first().map(String::as_str) == Some("skills")
+    {
+        return Ok(());
+    }
+    validate_managed_environment()?;
+    if flags.session != env::var("AGENT_BROWSER_SESSION").unwrap_or_default()
+        || flags.namespace != env::var("AGENT_BROWSER_NAMESPACE").ok()
+        || flags.profile != env::var("AGENT_BROWSER_PROFILE").ok()
+        || flags.executable_path != env::var("AGENT_BROWSER_EXECUTABLE_PATH").ok()
+        || flags.args != env::var("AGENT_BROWSER_ARGS").ok()
+    {
+        return Err("Browser scope and launch paths are owned by the host".to_string());
+    }
+    if let Some(config) = extract_config_path(args) {
+        if config != env::var("AGENT_BROWSER_CONFIG").ok() {
+            return Err("Browser configuration is owned by the host".to_string());
+        }
+    }
+    let engine = flags.engine.as_deref().unwrap_or("chrome");
+    if flags.auto_connect
+        || flags.cdp.is_some()
+        || flags.provider.is_some()
+        || flags.device.is_some()
+        || engine != "chrome"
+        || !flags.plugins.is_empty()
+    {
+        return Err("Managed browser commands cannot attach to external browsers".to_string());
+    }
+    let command = clean.first().map(String::as_str).unwrap_or_default();
+    if flags.cli_proxy
+        || flags.cli_proxy_bypass
+        || env::var_os("AGENT_BROWSER_PROXY").is_some()
+        || env::var_os("AGENT_BROWSER_PROXY_BYPASS").is_some()
+    {
+        return Err("Browser network configuration is owned by the host".to_string());
+    }
+    if command == "inspect"
+        || (command == "get" && clean.get(1).map(String::as_str) == Some("cdp-url"))
+    {
+        return Err("Managed Chrome does not expose a debugging endpoint".to_string());
+    }
+    if command == "connect" {
+        return Err("Managed browser commands cannot attach to external browsers".to_string());
+    }
+    if matches!(
+        command,
+        "install"
+            | "upgrade"
+            | "dashboard"
+            | "doctor"
+            | "profiles"
+            | "plugin"
+            | "plugins"
+            | "chat"
+            | "stream"
+    ) || (matches!(command, "close" | "quit" | "exit") && clean.iter().any(|arg| arg == "--all"))
+    {
+        return Err("Browser installation and shared services are owned by the host".to_string());
+    }
+    Ok(())
+}
