+// Bound unauthenticated input too; the limit includes the newline delimiter.
+#[cfg(feature = "managed-process")]
+const MANAGED_REQUEST_LIMIT: usize = 16 * 1024 * 1024;
+
+#[cfg(feature = "managed-process")]
+async fn read_managed_line<R: tokio::io::AsyncBufRead + Unpin>(
+    reader: &mut R,
+    line: &mut String,
+    limit: usize,
+) -> std::io::Result<usize> {
+    use std::io::{Error, ErrorKind};
+    let mut frame = Vec::new();
+    loop {
+        let available = reader.fill_buf().await?;
+        if available.is_empty() {
+            return if frame.is_empty() {
+                Ok(0)
+            } else {
+                Err(Error::new(
+                    ErrorKind::UnexpectedEof,
+                    "Truncated managed browser request",
+                ))
+            };
+        }
+        let newline = available.iter().position(|byte| *byte == b'\n');
+        let consumed = newline.map_or(available.len(), |index| index + 1);
+        if consumed > limit.saturating_sub(frame.len()) {
+            return Err(Error::new(
+                ErrorKind::InvalidData,
+                "Managed browser request exceeds the size limit",
+            ));
+        }
+        frame.extend_from_slice(&available[..consumed]);
+        reader.consume(consumed);
+        if newline.is_some() {
+            *line = String::from_utf8(frame).map_err(|_| {
+                Error::new(
+                    ErrorKind::InvalidData,
+                    "Managed browser request must be UTF-8",
+                )
+            })?;
+            return Ok(line.len());
+        }
+    }
+}
