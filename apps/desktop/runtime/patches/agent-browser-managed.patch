+enum CdpWriter {
+    WebSocket(WsSink),
+    #[cfg(feature = "managed-process")]
+    Pipe {
+        writer: Option<tokio::net::unix::OwnedWriteHalf>,
+        closed: tokio::sync::watch::Receiver<bool>,
+    },
+}
+
+impl CdpWriter {
+    async fn send_text(&mut self, text: String) -> Result<(), String> {
+        match self {
+            Self::WebSocket(writer) => writer
+                .send(Message::Text(text))
+                .await
+                .map_err(|e| e.to_string()),
+            #[cfg(feature = "managed-process")]
+            Self::Pipe { writer, closed } => {
+                use tokio::io::AsyncWriteExt;
+                if *closed.borrow() || closed.has_changed().is_err() {
+                    writer.take();
+                    return Err("CDP pipe is closed".to_string());
+                }
+                if text.len() > PIPE_FRAME_LIMIT {
+                    return Err("CDP pipe message exceeds its capacity".to_string());
+                }
+                // A cancelled partial frame must close the channel, never become
+                // the prefix of a later command. Only a complete write restores it.
+                let mut owned = writer.take().ok_or("CDP pipe is closed")?;
+                let result = tokio::select! {
+                    result = async {
+                        owned.write_all(text.as_bytes()).await.map_err(|e| e.to_string())?;
+                        owned.write_all(&[0]).await.map_err(|e| e.to_string())
+                    } => result,
+                    _ = closed.changed() => Err("CDP pipe is closed".to_string()),
+                };
+                result?;
+                *writer = Some(owned);
+                Ok(())
+            }
+        }
+    }
+
+    async fn ping(&mut self) -> Result<(), String> {
+        match self {
+            Self::WebSocket(writer) => writer
+                .send(Message::Ping(Vec::new()))
+                .await
+                .map_err(|e| e.to_string()),
+            #[cfg(feature = "managed-process")]
+            Self::Pipe { .. } => Err("CDP pipe does not use WebSocket keepalive".to_string()),
+        }
+    }
+}
